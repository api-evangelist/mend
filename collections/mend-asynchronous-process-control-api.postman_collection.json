          "name": "Get Async Process Status",
          "request": {
            "name": "Get Async Process Status",
            "description": {
              "content": " Returns the status of an asynchronous process. Asynchronous processes allow requests to be performed in\n the background, enabling you to initiate tasks and check their completion status later.\n\n **Requests Performed in Async Process:**\n+ Post Apply OrganizationPolicies On Inventory.\n+ Post Apply Product Policies On Inventory.\n+ Post Apply Project Policies On Inventory.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2.0",
                "orgs",
                ":orgToken",
                "asyncProcessStatus",
                ":statusUuid"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "orgToken",
                  "description": "(Required) org UUID (by running Entities - Organization > Get User Organizations) or API Key (from the Mend SCA App: **Integrate** tab > **API Key**)."
