{
  "opencollection": "1.0.0",
  "info": {
    "name": "Mend Access Management Scans API",
    "version": "3.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Scans",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Project Scans",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://baseUrl/api/v3.0/orgs/:orgUuid/projects/:projectUuid/scans",
            "params": [
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "Parameter indicates the starting point for retrieving results, the first call doesn't include a cursor parameter in the request, the API response includes the first set of results along with a cursor pointing to the last item retrieved."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Specifies the maximum number of items to be returned in the response."
              },
              {
                "name": "orgUuid",
                "value": "",
                "type": "path",
                "description": "org UUID (from the Mend App: **Administration** General > **Organization UUID**)."
              },
              {
                "name": "projectUuid",
                "value": "",
                "type": "path",
                "description": "UUID of the project"
              }
            ]
          },
          "docs": "Returns the project related scans"
        },
        {
          "info": {
            "name": "Get Scan",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://baseUrl/api/v3.0/orgs/:orgUuid/projects/:projectUuid/scans/:scanUuid",
            "params": [
              {
                "name": "orgUuid",
                "value": "",
                "type": "path",
                "description": "org UUID (from the Mend App: **Administration** General > **Organization UUID**)."
              },
              {
                "name": "projectUuid",
                "value": "",
                "type": "path",
                "description": "UUID of the project"
              },
              {
                "name": "scanUuid",
                "value": "",
                "type": "path",
                "description": "Scan UUID"
              }
            ]
          },
          "docs": "Get Scan"
        },
        {
          "info": {
            "name": "Get Scan Summary",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://baseUrl/api/v3.0/orgs/:orgUuid/projects/:projectUuid/scans/:scanUuid/summary",
            "params": [
              {
                "name": "orgUuid",
                "value": "",
                "type": "path",
                "description": "org UUID (from the Mend App: **Administration** General > **Organization UUID**)."
              },
              {
                "name": "projectUuid",
                "value": "",
                "type": "path",
                "description": "UUID of the project"
              },
              {
                "name": "scanUuid",
                "value": "",
                "type": "path",
                "description": "Scan UUID"
              }
            ]
          },
          "docs": "Get Scan Summary"
        },
        {
          "info": {
            "name": "Get Scan Tags",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://baseUrl/api/v3.0/orgs/:orgUuid/projects/:projectUuid/scans/:scanUuid/tags",
            "params": [
              {
                "name": "orgUuid",
                "value": "",
                "type": "path",
                "description": "org UUID (from the Mend App: **Administration** General > **Organization UUID**)."
              },
              {
                "name": "projectUuid",
                "value": "",
                "type": "path",
                "description": "UUID of the project"
              },
              {
                "name": "scanUuid",
                "value": "",
                "type": "path",
                "description": "Scan UUID"
              }
            ]
          },
          "docs": "Get Scan Tags"
        },
        {
          "info": {
            "name": "Get Scans Comparison",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://baseUrl/api/v3.0/orgs/:orgUuid/scans/compare",
            "params": [
              {
                "name": "orgUuid",
                "value": "",
                "type": "path",
                "description": "org UUID (from the Mend App: **Administration** General > **Organization UUID**)."
              },
              {
                "name": "sourceScanUuid",
                "value": "",
                "type": "query",
                "description": "UUID of the source (baseline) scan"
              },
              {
                "name": "targetScanUuid",
                "value": "",
                "type": "query",
                "description": "UUID of the target (comparison) scan; defaults to the project's latest scan when omitted"
              },
              {
                "name": "type",
                "value": "",
                "type": "query",
                "description": "Finding category to compare"
              }
            ]
          },
          "docs": "Compares two scans within an organization and returns a structured diff of findings, including per-finding diff type (ADDED, REMOVED, MODIFIED, UNCHANGED), aggregate stats, and field-level change details for modified findings."
        },
        {
          "info": {
            "name": "Get SBOM import logs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://baseUrl/api/v3.0/projects/:projectUuid/scans/:scanUuid/dependencies/SBOM/logs",
            "params": [
              {
                "name": "projectUuid",
                "value": "",
                "type": "path",
                "description": "UUID of the project"
              },
              {
                "name": "scanUuid",
                "value": "",
                "type": "path",
                "description": "Scan UUID"
              }
            ]
          },
          "docs": "Returns processing and validation logs generated during SBOM import for a specific scan."
        }
      ]
    }
  ],
  "bundled": true
}