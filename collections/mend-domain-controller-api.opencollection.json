{
  "opencollection": "1.0.0",
  "info": {
    "name": "Mend Access Management domain-controller API",
    "version": "3.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "domain-controller",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get User Managed Domains",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://baseUrl/api/v2.0/orgs/managed-domains"
          },
          "docs": "Returns a list of all organizations where the current user is a domain or application admin."
        }
      ]
    }
  ],
  "bundled": true
}