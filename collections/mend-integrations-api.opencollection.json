{
  "opencollection": "1.0.0",
  "info": {
    "name": "Mend Access Management Integrations API",
    "version": "3.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Integrations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get All Integrations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://baseUrl/api/v3.0/orgs/:orgUuid/integrations",
            "params": [
              {
                "name": "orgUuid",
                "value": "",
                "type": "path",
                "description": "org UUID (from the Mend App: **Administration** General > **Organization UUID**)."
              }
            ]
          },
          "docs": "Returns all integrations for the given organization with optional filtering."
        }
      ]
    }
  ],
  "bundled": true
}