{
  "opencollection": "1.0.0",
  "info": {
    "name": "Mend Access Management Administration - Labels API",
    "version": "3.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Administration - Labels",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get All Organization Labels",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://baseUrl/api/v3.0/orgs/:orgUuid/labels",
            "params": [
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "Parameter indicates the starting point for retrieving results, the first call doesn't include a cursor parameter in the request, the API response includes the first set of results along with a cursor pointing to the last item retrieved."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Specifies the maximum number of items to be returned in the response."
              },
              {
                "name": "orgUuid",
                "value": "",
                "type": "path",
                "description": "org UUID (from the Mend App: **Administration** General > **Organization UUID**)."
              }
            ]
          },
          "docs": "Returns a list of all labels in an organization (paginated)"
        },
        {
          "info": {
            "name": "Add Label Definition",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://baseUrl/api/v3.0/orgs/:orgUuid/labels",
            "params": [
              {
                "name": "orgUuid",
                "value": "",
                "type": "path",
                "description": "org UUID (from the Mend App: **Administration** General > **Organization UUID**)."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Adds a new label definition"
        },
        {
          "info": {
            "name": "Rename Label",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://baseUrl/api/v3.0/orgs/:orgUuid/labels/:labelUuid",
            "params": [
              {
                "name": "orgUuid",
                "value": "",
                "type": "path",
                "description": "org UUID (from the Mend App: **Administration** General > **Organization UUID**)."
              },
              {
                "name": "labelUuid",
                "value": "",
                "type": "path",
                "description": "Label UUID (Administration > Labels)"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Renames an existing label"
        },
        {
          "info": {
            "name": "Remove Label Definition",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://baseUrl/api/v3.0/orgs/:orgUuid/labels/:labelUuid",
            "params": [
              {
                "name": "orgUuid",
                "value": "",
                "type": "path",
                "description": "org UUID (from the Mend App: **Administration** General > **Organization UUID**)."
              },
              {
                "name": "labelUuid",
                "value": "",
                "type": "path",
                "description": "Label UUID (Administration > Labels)"
              }
            ]
          },
          "docs": "Removes a label definition"
        }
      ]
    }
  ],
  "bundled": true
}